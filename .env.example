# Copy to apps/api/.env and fill in. Integrations fall back to demo mode when their keys are missing.

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3001

# --- Database (Neon) ---
DATABASE_URL=            # pooled connection string
DATABASE_DIRECT_URL=     # direct connection string, used for migrations
DATABASE_AI_URL=         # read-only role for Ask Remedist
