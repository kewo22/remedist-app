# Copy to apps/api/.env and fill in. Never commit the real .env.

PORT=3001

# Neon Postgres (AWS Singapore). Both come from the Neon console > Connect.
# Pooled URL: the host contains "-pooler". Used for every normal query.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/remedist?sslmode=verify-full
# Direct URL: the same host without "-pooler". Used for migrations and job locks.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/remedist?sslmode=verify-full
