# Copy to apps/api/.env and fill in. Never commit the real .env.

# development | test | production. production switches logs to JSON and makes WEB_URL and APP_URL required.
NODE_ENV=development
PORT=3001
# The web app's origin: the only origin CORS allows, and the base for links in emails.
WEB_URL=http://localhost:3000
# This API's public URL (webhooks, OAuth callbacks).
APP_URL=http://localhost:3001
# Lowest level printed: fatal | error | warn | log | debug | verbose. debug also shows /health probes.
LOG_LEVEL=log

# Signs staff access tokens. Required, at least 32 random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_JWT_SECRET=
# Signs client (patient portal) access tokens. Required, same rules, and must differ from ADMIN_JWT_SECRET.
JWT_SECRET=

# Email via Resend. Blank = demo mode: emails are logged (never their codes), not sent, and outside
# production the sign-up and reset responses include `devCode` so the flow can be tested.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM=The Remedist <hello@theremedist.com>
# Comma-separated staff emails for security alerts (the daily OTP cap).
ADMIN_ALERT_EMAILS=

# Google sign-in (the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID). Blank = outside production, only
# `demo:<email>[:<name>]` test tokens are accepted; in production, Google sign-in is unavailable.
GOOGLE_OAUTH_CLIENT_ID=

# Cloudflare Turnstile. Blank = every challenge passes (demo mode).
TURNSTILE_SECRET_KEY=

# One-time codes: clinic-wide sends per UTC day, and how long phone/reset codes stay valid (minutes).
DAILY_OTP_SEND_CAP=300
OTP_CODE_TTL_MINUTES=10

# Neon Postgres (AWS Singapore). Easiest: run `neon env pull` in apps/api after
# `neon checkout dev`. It fills in the Neon variables below and keeps the rest of this file.
# Local development uses the `dev` branch, never `production`.

# Pooled URL: the host contains "-pooler". Used for every normal query.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL: the same host without "-pooler". Used for migrations and job locks.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.c-5.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Also written by `neon env pull`; the API doesn't read them.
NEON_BRANCH=dev
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Initial passwords for the staff logins `pnpm --filter api seed` creates (at least 12 characters).
# Read only by the seed, never by the API. A login whose password is blank isn't created, and an
# existing login is never changed, so these can be removed after the first seed.
SEED_RAUZAN_PASSWORD=
SEED_PRANAVAN_PASSWORD=
SEED_NASIF_PASSWORD=
SEED_ASK_REMEDIST_PASSWORD=
# Optional: the developer's super_admin login, the only way that role is granted. All three or none.
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
