# Copy to apps/web/.env.local and fill in. Every value here ends up in the browser bundle:
# never put a secret in a NEXT_PUBLIC_* variable.

# mock: screens use the fixtures in src/lib/api/mocks (no API needed).
# live: screens call the API at NEXT_PUBLIC_API_URL. Switch once the API domain is merged.
NEXT_PUBLIC_API_MODE=mock
# The versioned API base. The API must list this app's origin in its WEB_URL (CORS with cookies).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional until the matching feature is built.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SENTRY_DSN=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=